ANTHROPIC_API_KEY=

# Required in production — share links won't survive across regions otherwise.
# Free tier at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — enables the "Email me this roast" button on result pages.
# Get the API key at app.composio.dev. Authorize a Gmail account in the
# dashboard, then put the user_id you used (e.g. "default") below.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
